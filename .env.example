# Home Assistant development container
TZ=America/Chicago

# Configure these in your local shell or a separate ignored .env file after onboarding.
PWCE_HA_URL_HOME_ONE=http://127.0.0.1:8123
PWCE_HA_TOKEN_REF_HOME_ONE=env://PWCE_HA_TOKEN_HOME_ONE
# Set this only in your local ignored environment; never commit the value.
PWCE_HA_TOKEN_HOME_ONE=
# Optional second site for multi-site context and isolation checks.
PWCE_HA_URL_HOME_TWO=http://127.0.0.1:8124
PWCE_HA_TOKEN_REF_HOME_TWO=env://PWCE_HA_TOKEN_HOME_TWO
PWCE_HA_TOKEN_HOME_TWO=
PWCE_STUDIO_TOKEN=
PWCE_GATEWAY_TOKEN=
PWCE_GATEWAY_PRINCIPAL_REF=agent.fixture
PWCE_GATEWAY_SITE_REFS=home.one
PWCE_STUDIO_LIVE_EVENTS=true
PWCE_HA_RECONNECT_INITIAL_MS=1000
PWCE_HA_RECONNECT_MAX_MS=30000
PWCE_HA_RECONNECT_MAX_ATTEMPTS=10
