{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwce.local/contracts/pwce-agent-gateway-authority-request-1.0.0.schema.json",
  "title": "PWCE Agent Gateway authority request",
  "type": "object",
  "required": ["siteRefs"],
  "properties": {
    "siteRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "ttlMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "assistantRef": { "type": ["string", "null"], "maxLength": 128 },
    "endpointRef": { "type": ["string", "null"], "maxLength": 128 },
    "participantRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "audienceRef": { "type": ["string", "null"], "maxLength": 128 }
  },
  "additionalProperties": false
}
