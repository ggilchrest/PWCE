{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pwce.local/contracts/pwce-agent-gateway-request-1.0.0.schema.json",
  "title": "PWCE Agent Gateway request envelope",
  "type": "object",
  "required": ["profileId", "profileVersion", "operation", "authorityContextRef", "requestId", "correlationId", "worldRef", "executionEnvironmentRef"],
  "properties": {
    "profileId": { "const": "pwce-agent-gateway.v1" },
    "profileVersion": { "const": "1.0.0" },
    "operation": { "type": "string", "minLength": 1 },
    "authorityContextRef": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "worldRef": { "type": "string", "minLength": 1, "maxLength": 128 },
    "executionEnvironmentRef": { "enum": ["normal", "live", "test", "replay", "simulation", "dry-run"] },
    "deadline": { "type": "string", "format": "date-time" },
    "assistantRef": { "type": ["string", "null"] },
    "endpointRef": { "type": ["string", "null"] },
    "participantRefs": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
    "audienceRef": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
